# =============================================================================
# repos/shortical-mock-harness — Standalone Clean-Room Mock Suite (.env.example)
# 100% Isolated from repos/alt-payments (Zero Mock Code in Production Image)
# =============================================================================

APP_ENV=local
MOCK_API_PORT=4470
MOCK_STOREFRONT_PORT=5390

# Local laptop. Cloud copies are gitignored:
#   .env.dev-ex  this account, dev-*.entlora.com
#   .env.dev     Shortical's account, filled when that domain exists
BILLING_GATEWAY_URL=http://localhost:4460
CORS_ALLOWED_ORIGINS=http://localhost:5380,http://localhost:5390

S2S_HMAC_SECRET_CURRENT=dev_s2s_hmac_secret_shortical_2026_primary
BILLING_ROOT_TOKEN=dev_root_token_shortical_2026
BILLING_FINANCE_TOKEN=dev_finance_token_shortical_2026
APPLE_BUNDLE_ID=com.shortical.app
APPLE_OFFER_SIGNING_SECRET=p8_sand_apple_storekit2_keyid_7721f
GOOGLE_PACKAGE_NAME=com.shortical.app
GOOGLE_RTDN_OIDC_AUDIENCE=http://localhost:4460/api/v1/billing/webhooks/google

# Default simulated webhook behavior: always_200_ok | fail_3_times_then_200 | always_500_error
MOCK_WEBHOOK_RESPONSE_MODE=always_200_ok
